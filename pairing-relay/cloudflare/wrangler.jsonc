{
  "name": "niktv-pairing-relay",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "PairingSession" }
    ]
  },
  "exports": {
    "PairingSession": { "type": "durable-object", "storage": "sqlite" }
  }
}
