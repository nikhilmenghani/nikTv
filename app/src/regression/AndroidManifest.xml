<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
 <application android:name="android.app.Application" tools:replace="android:name">
  <activity android:name="com.nikhil.niktv.sports.PlaybackSimulationActivity"
   android:label="NikTV playback test" android:exported="true" android:launchMode="singleTop"
   android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
   <intent-filter>
    <action android:name="android.intent.action.VIEW" />
    <category android:name="android.intent.category.DEFAULT" />
    <category android:name="android.intent.category.BROWSABLE" />
    <data android:scheme="http" />
    <data android:scheme="https" />
    <data android:scheme="content" />
    <data android:scheme="file" />
    <data android:mimeType="video/*" />
    <data android:mimeType="application/dash+xml" />
    <data android:mimeType="application/x-mpegurl" />
    <data android:mimeType="application/vnd.apple.mpegurl" />
   </intent-filter>
   <intent-filter>
    <action android:name="android.intent.action.SEND" />
    <category android:name="android.intent.category.DEFAULT" />
    <data android:mimeType="video/*" />
    <data android:mimeType="text/plain" />
    <data android:mimeType="application/dash+xml" />
    <data android:mimeType="application/x-mpegurl" />
    <data android:mimeType="application/vnd.apple.mpegurl" />
   </intent-filter>
  </activity>
  <activity android:name="com.nikhil.niktv.ui.PlaybackFixtureHostActivity" android:exported="false" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode" />
  <activity android:name="com.nikhil.niktv.ui.SportsFixtureHostActivity" android:exported="false" android:supportsPictureInPicture="true" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode" />
  <activity android:name="com.nikhil.niktv.ui.PlaybackRegressionActivity" android:exported="false" />
  <activity android:name="com.nikhil.niktv.ui.ParentalRegressionActivity" android:exported="false" />
  <activity android:name="com.nikhil.niktv.ui.PlayerQueueRegressionActivity" android:exported="false" />
 </application>
</manifest>
